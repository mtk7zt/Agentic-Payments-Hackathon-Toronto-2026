# Gateway URL. Leave unset to run the cockpit on the simulated ledger.
# On Vercel, leave this unset. The server uses MANDATE_API_URL instead.
NEXT_PUBLIC_MANDATE_API_URL=http://localhost:8000

# DEV ONLY. Must match MANDATE_OWNER_TOKEN on the gateway.
# NEXT_PUBLIC_ values are compiled into the browser bundle, so anyone who loads
# the page can read this token. Never set it for a shared or deployed build.
# A Vercel production or preview build fails if this is set.
NEXT_PUBLIC_MANDATE_OWNER_TOKEN=

# Server only. Set these in Vercel, not in the browser bundle.
# NEXTAUTH_URL=https://app.mandatepay.tech
# NEXTAUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MANDATE_CONSOLE_OWNER_EMAIL=founder@example.com
# MANDATE_API_URL=https://api.mandatepay.tech
# MANDATE_OWNER_TOKEN=
