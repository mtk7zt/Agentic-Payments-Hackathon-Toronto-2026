# Copy to .env. Never commit real values.

# --- Payment rail -------------------------------------------------------
# mock = deterministic fake rail (default). goat = GOAT Flow x402 Testnet3.
MANDATE_RAIL=mock
GOAT_FLOW_API_URL=https://flow-api.testnet3.goat.network
GOAT_FLOW_API_KEY=
GOAT_FLOW_API_SECRET=
GOAT_FLOW_MERCHANT_ID=
GOAT_FLOW_CHAIN_ID=48816
GOAT_FLOW_TOKEN_SYMBOL=USDC
GOAT_FLOW_TOKEN_CONTRACT=0x29D1Ee93e9ecf6E50F309f498e40a6b42D352Fa1
# Address of the funded agent wallet that pays.
GOAT_FLOW_FROM_ADDRESS=

# --- Controlled synthetic seller ----------------------------------------
# mock is the existing in-process fixture. http uses the separate seller service.
MANDATE_SELLER_MODE=mock
MANDATE_SELLER_URL=http://127.0.0.1:8001
# Shared only by the executor and seller service; never send it to the frontend.
MANDATE_SELLER_TOKEN=

# --- Mandate ------------------------------------------------------------
# SQLite path, or :memory: for an in-process ledger.
MANDATE_DB=mandate.db
# Required for owner routes, including session issuance, state, evidence and SSE.
# Unset means owner routes deny all requests; never give this token to the agent.
MANDATE_OWNER_TOKEN=
# Optional independent HMAC key for locally signed evidence checkpoints. Keep private.
MANDATE_CHECKPOINT_KEY=
MANDATE_CORS_ORIGINS=http://localhost:3000

# --- Frontend -----------------------------------------------------------
# Leave empty to run the cockpit on its built-in simulated ledger.
NEXT_PUBLIC_MANDATE_API_URL=

# Qatom (TODAQ) rail — MANDATE_RAIL=qatom. No API key: the one-time Qatom sign-in
# saves a token file; this only says where it is. Never commit the token file.
QATOM_MCP_URL=https://mcp.m.todaq.net/mcp
QATOM_TOKEN_FILE=~/.toda-mcp-token.json
# Mandate catalog item -> Qatom catalog id, e.g. {"btc_read": 22}
QATOM_ITEM_MAP={}
