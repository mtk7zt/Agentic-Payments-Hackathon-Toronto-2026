# Copy to .env. Never commit real values.

# --- Mode -----------------------------------------------------------------
# production (default): real database, real rail, real seller, strong owner token; refuses to start otherwise.
# sandbox: local development and demos; allows the sandbox rail and seller and seeds sample sellers.
MANDATE_MODE=sandbox

# --- Database -------------------------------------------------------------
# PostgreSQL in production. Leave DATABASE_URL empty to use the Postgres service in
# deploy/docker-compose.yml (see docs/DEPLOY.md). Or set an external URI, e.g. Supabase
# "Session pooler":
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Leave empty in sandbox to use ./mandate-sandbox.db. Apply or upgrade the schema with:
#   python -m backend.migrate
DATABASE_URL=
# Bundled Postgres only. Superuser for the Postgres image. The gateway does not use this.
POSTGRES_PASSWORD=
# Bundled Postgres only. Password for the mandate_gateway role. Use a URL-safe random string.
MANDATE_DB_PASSWORD=
# Bundled Postgres only. SELECT-only role, for a later read-only client.
MANDATE_READONLY_PASSWORD=
# Bundled Postgres data directory. Empty uses a named volume. On the VM: /srv/mandate/postgres
MANDATE_PGDATA=

# --- Payment rail -------------------------------------------------------
# mock = sandbox rail (sandbox mode only). goat = GOAT Flow x402. qatom = Qatom agent checkout.
MANDATE_RAIL=mock
GOAT_FLOW_API_URL=https://flow-api.testnet3.goat.network
GOAT_FLOW_API_KEY=
GOAT_FLOW_API_SECRET=
GOAT_FLOW_MERCHANT_ID=
GOAT_FLOW_CHAIN_ID=48816
GOAT_FLOW_TOKEN_SYMBOL=USDC
GOAT_FLOW_TOKEN_CONTRACT=0x29D1Ee93e9ecf6E50F309f498e40a6b42D352Fa1
# Address of the funded agent wallet that pays.
GOAT_FLOW_FROM_ADDRESS=

# --- Controlled synthetic seller ----------------------------------------
# mock = sandbox seller (sandbox mode only). http = a real seller service at MANDATE_SELLER_URL.
MANDATE_SELLER_MODE=mock
MANDATE_SELLER_URL=http://127.0.0.1:8001
# Shared only by the executor and seller service; never send it to the frontend.
MANDATE_SELLER_TOKEN=

# --- Mandate ------------------------------------------------------------
# Older name for DATABASE_URL; still read if DATABASE_URL is empty.
MANDATE_DB=
# Required for owner routes, including session issuance, state, evidence and SSE. Production needs
# at least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never give this token to the agent or the browser.
MANDATE_OWNER_TOKEN=
# Optional independent HMAC key for locally signed evidence checkpoints. Keep private.
MANDATE_CHECKPOINT_KEY=
MANDATE_CORS_ORIGINS=http://localhost:3000

# --- Frontend -----------------------------------------------------------
# The gateway URL the cockpit talks to.
NEXT_PUBLIC_MANDATE_API_URL=

# Qatom (TODAQ) rail — MANDATE_RAIL=qatom. No API key: the one-time Qatom sign-in
# saves a token file; this only says where it is. Never commit the token file.
QATOM_MCP_URL=https://mcp.m.todaq.net/mcp
QATOM_TOKEN_FILE=~/.toda-mcp-token.json
# Mandate catalog item -> Qatom catalog id, e.g. {"btc_read": 22}
QATOM_ITEM_MAP={}

# Deployment (docs/DEPLOY.md): the public hostname Caddy serves over HTTPS, for example api.mandatepay.tech
MANDATE_DOMAIN=

# Optional Datadog monitoring (docs/DEPLOY.md, profile "monitoring")
DD_API_KEY=
DD_SITE=datadoghq.com
